<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConversorLibros.App.ViewModels"
             x:Class="ConversorLibros.App.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Biblioteca">

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Biblioteca" Style="{StaticResource Headline}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Actualizar" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
        </Grid>

        <Label Grid.Row="1" Text="Aún no hay audiolibros en la carpeta de salida. Convierte un EPUB en 'Nueva conversión'."
               Style="{StaticResource Muted}" IsVisible="{Binding IsEmpty}" />

        <CollectionView Grid.Row="2" ItemsSource="{Binding Books}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:AudiobookItem">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Image Source="{Binding Cover}" WidthRequest="80" HeightRequest="80" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Author}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding Details}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Abrir carpeta" Command="{Binding OpenCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
