<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ConversorLibros.App.Views"
       x:Class="ConversorLibros.App.AppShell"
       Title="ConversorLibros"
       FlyoutBehavior="Locked">

    <ShellContent Title="Biblioteca" Route="library" ContentTemplate="{DataTemplate views:LibraryPage}" />
    <ShellContent Title="Nueva conversión" Route="new" ContentTemplate="{DataTemplate views:NewConversionPage}" />
    <ShellContent Title="Ajustes" Route="settings" ContentTemplate="{DataTemplate views:SettingsPage}" />

</Shell>
